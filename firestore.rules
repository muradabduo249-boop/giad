rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read public site content
    match /products/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /news/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /jobs/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /site_settings/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /contact_messages/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
    match /quotation_requests/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
    match /job_applications/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
  }
}
